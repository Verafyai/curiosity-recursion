# Copy to .env and fill in. No secrets are needed for the rule-based path.
TEMPORAL_ADDRESS=localhost:7233
CR_TASK_QUEUE=curiosity-recursion
# A contact address for the HTTP user agent (polite access to public archives). Required by courtesy.
CR_CONTACT=
# Optional public source catalogue base URL (read-only GETs). Leave empty to skip.
CR_CATALOG_URL=
# Question memory and outbox locations
CR_DB=data/cr.db
CR_OUTBOX=data/outbox-not-sent
# Only for the grounded model generator and the B0/B1 baselines. Worker environment only.
ANTHROPIC_API_KEY=
CR_LLM_MODEL=claude-sonnet-5-5
